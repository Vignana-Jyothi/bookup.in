FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY frontend/ ./frontend/
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_APP_URL=https://calup.app
ARG VITE_API_URL=/api
ARG VITE_SUPPORT_EMAIL=support@calup.app
ARG VITE_DEMO_SLUG
ARG VITE_CASHFREE_V1_ENABLED=false
ARG VITE_LEGAL_NAME=Calup
ARG VITE_BUSINESS_ADDRESS
ARG VITE_GRIEVANCE_CONTACT_NAME
ARG VITE_GRIEVANCE_EMAIL
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.28-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 4242
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:4242/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
