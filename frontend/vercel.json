{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets(?:/|$)|src(?:/|$)|api(?:/|$)|calup-version\\.json$).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm --prefix .. run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm --prefix .. ci"
}
